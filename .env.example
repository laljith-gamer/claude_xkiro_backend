# ============================================
# xKiro → Anthropic Proxy Configuration
# ============================================
# 
# Get your FREE API key at: https://xkiro.com
# Free tier: 5 million tokens/day, no credit card needed
#

# xKiro OpenAI-compatible API endpoint
UPSTREAM_BASE_URL=https://api.xkiro.com/v1

# Paste your xKiro API key below (replace the placeholder)
UPSTREAM_API_KEY=sk-your-xkiro-api-key-here

# Local proxy settings
LISTEN_HOST=127.0.0.1
LISTEN_PORT=3000

# Default model override (leave EMPTY to use per-model mapping below)
# If set, ALL requests use this model regardless of Claude selector.
# UPSTREAM_MODEL=deepseek/deepseek-v4-pro
UPSTREAM_MODEL=

# ── Model Mapping (active when UPSTREAM_MODEL is empty) ──
# Each Claude model in the selector maps to a different free xKiro model:
#   Opus 4.8    -> deepseek/deepseek-v4-pro       (Best overall)
#   Sonnet 5    -> qwen/qwen3.8-max:free           (Best vision+reasoning)
#   Fable 5     -> qwen/qwen3-coder-plus:free      (Best for coding)
#   Opus 5      -> deepseek/deepseek-v4-flash       (Fast + powerful)
#   Sonnet 4.6  -> mistralai/mistral-medium-3.5     (Mistral vision)
#   Haiku 4.5   -> minimax/minimax-m3:free          (Fast answers)
#   Opus 4.6    -> qwen/qwen3.7-max:free            (Qwen reasoning)
#   Fable 5.1   -> openai/gpt-5.3-codex-spark      (Codex coding)
#   Opus 4.7    -> qwen/qwen3.5-397b-a17b:free     (Largest MoE)
#
# To customize a mapping, add to this file:
#   MODEL_MAP_OPUS_4_8=mistralai/mistral-medium-3.5
